{
  "name": "template-tailwind-portfolio_2",
  "version": "1.0.0",
  "main": "tailwind.config.js",
  "scripts": {
    "dev": "tailwindcss -i ./css/tailwind.css -o ./css/tailwind.css --watch",
    "build": "npm run build:tailwind && npm run build:css && npm run build:js",
    "build:tailwind": "tailwindcss -i ./css/tailwind.css -o ./css/tailwind.css",
    "build:css": "npx clean-css-cli css/tailwind.css css/style.css -o css/all.min.css",
    "build:js": "npx terser js/translations.js js/main.js --compress --mangle -o js/bundle.min.js"
  },
  "keywords": [],
  "author": "Laurence Pirard",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "tailwindcss": "^3.4.4"
  }
}
